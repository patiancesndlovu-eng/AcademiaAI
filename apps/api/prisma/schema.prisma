generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───

enum NotebookVisibility {
  private
  shared
  public
}

enum NotebookRole {
  owner
  editor
  viewer
}

enum SourceType {
  upload
  url
  text
  drive
}

enum SourceStatus {
  queued
  processing
  ready
  failed
}

enum GenerationType {
  quiz
  flashcards
  summary
  report
  mindmap
}

enum GenerationStatus {
  queued
  processing
  completed
  failed
  cancelled
}

enum MessageRole {
  user
  assistant
  system
}

// ─── Models ───

model User {
  id           String           @id @default(cuid())
  clerkId      String           @unique
  email        String           @unique
  displayName  String?
  avatarUrl    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  chatMessages ChatMessage[]
  jobs         GenerationJob[]
  notes        Note[]
  notebooks    Notebook[]
  memberships  NotebookMember[]
}

model Notebook {
  id           String             @id @default(cuid())
  ownerId      String
  title        String
  description  String?
  coverAssetId String?
  visibility   NotebookVisibility @default(private)
  settingsJson Json               @default("{}")
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  chatMessages ChatMessage[]
  collections  CollectionItem[]
  jobs         GenerationJob[]
  notes        Note[]
  owner        User               @relation(fields: [ownerId], references: [id])
  members      NotebookMember[]
  outputs      Output[]
  sources      Source[]

  @@index([ownerId, updatedAt])
  @@index([deletedAt])
}

model NotebookMember {
  id         String        @id @default(cuid())
  notebookId String
  userId     String
  role       NotebookRole
  createdAt  DateTime      @default(now())
  expiresAt  DateTime?
  notebook   Notebook      @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notebookId, userId])
  @@index([notebookId])
  @@index([userId])
}

model Source {
  id                 String       @id @default(cuid())
  notebookId         String
  type               SourceType
  title              String
  canonicalUrl       String?
  domain             String?
  author             String?
  publishedAt        DateTime?
  filePath           String?
  extractedText      String?
  status             SourceStatus @default(queued)
  selected           Boolean      @default(true)
  wordCount          Int?
  progress           Int          @default(0)
  processingAttempts Int          @default(0)
  processingError    String?
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  citations          Citation[]
  notebook           Notebook     @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  chunks             SourceChunk[]

  @@index([notebookId, selected])
  @@index([notebookId, status])
  @@index([notebookId, deletedAt])
  @@index([deletedAt])
}

model SourceChunk {
  id          String  @id @default(cuid())
  sourceId    String
  text        String
  pageOffset  Int?
  startOffset Int?
  endOffset   Int?
  embedding   String?
  source      Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model ChatMessage {
  id         String      @id @default(cuid())
  notebookId String
  userId     String?
  role       MessageRole
  content    String
  modelMeta  Json?
  createdAt  DateTime    @default(now())
  notebook   Notebook    @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id])
  citations  Citation[]

  @@index([notebookId, createdAt])
}

model Citation {
  id          String      @id @default(cuid())
  messageId   String
  sourceId    String
  quote       String?
  startOffset Int?
  page        Int?
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  source      Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([sourceId])
}

model GenerationJob {
  id          String           @id @default(cuid())
  notebookId  String
  requestedBy String
  type        GenerationType
  config      Json
  status      GenerationStatus @default(queued)
  progress    Int              @default(0)
  outputId    String?          @unique
  error       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  notebook    Notebook         @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [requestedBy], references: [id])
  output      Output?

  @@index([notebookId, status])
  @@index([requestedBy])
  @@index([status])
}

model Output {
  id          String          @id @default(cuid())
  notebookId  String
  jobId       String          @unique
  type        GenerationType
  title       String
  content     Json
  artifactUrl String?
  savedState  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  job         GenerationJob   @relation(fields: [jobId], references: [id])
  notebook    Notebook        @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@index([notebookId])
}

model Note {
  id         String   @id @default(cuid())
  notebookId String
  authorId   String
  body       String
  sourceIds  String[]
  outputId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  author     User     @relation(fields: [authorId], references: [id])
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@index([notebookId, createdAt])
  @@index([authorId])
}

model Collection {
  id        String           @id @default(cuid())
  ownerId   String
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items     CollectionItem[]
}

model CollectionItem {
  collectionId String
  notebookId   String
  position     Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  notebook     Notebook   @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@id([collectionId, notebookId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actor     String
  action    String
  resource  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}
