# Database (PostgreSQL)
DATABASE_URL=postgresql://academiaai:academiaai_dev@localhost:5432/academiaai

# Redis (cache, rate limiting, BullMQ queues)
REDIS_URL=redis://localhost:6390

# Clerk (https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=...
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Retrieval bounds
RETRIEVAL_TOP_K=10
CONTEXT_MAX_CHARS=24000

# Web ingestion
WEB_FETCH_TIMEOUT_MS=10000
WEB_FETCH_MAX_BYTES=5242880
WEB_FETCH_MAX_REDIRECTS=3

# Web search (https://serpapi.com) — required for Sources web search, else API returns 503 SEARCH_DISABLED
SERP_API_KEY=

# Upload intents
UPLOAD_INTENT_TTL_SECONDS=900

# Observability
LOG_LEVEL=info
